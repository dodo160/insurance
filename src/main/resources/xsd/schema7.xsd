<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:client="/insurance/client" xmlns:employee="/insurance/employee" xmlns:insurance="/insurance/insurance" xmlns:reinsurance="/insurance/reinsurance" xmlns:tariff="/insurance/tariff" xmlns:user="/insurance/user" version="1.0">
        
  
  
  <xs:import namespace="/insurance/insurance" schemaLocation="Insurance.xsd"/>
        
  
  
  <xs:import namespace="/insurance/reinsurance" schemaLocation="Reinsurance.xsd"/>
        
  
  
  <xs:import namespace="/insurance/tariff" schemaLocation="Tariff.xsd"/>
        
  
  
  <xs:import namespace="/insurance/user" schemaLocation="User.xsd"/>
        
  
  
  <xs:import namespace="/insurance/client" schemaLocation="Client.xsd"/>
        
  
  
  <xs:import namespace="/insurance/employee" schemaLocation="Employee.xsd"/>
        
  
  
  <xs:element name="client" type="client:client"/>
        
  
  
  <xs:element name="employee" type="employee:employee"/>
        
  
  
  <xs:element name="insurance" type="insurance:insurance"/>
        
  
  
  <xs:element name="reinsurance" type="reinsurance:reinsurance"/>
        
  
  
  <xs:element name="tariff" type="tariff:tariff"/>
        
  
  
  <xs:element name="user" type="user:user"/>
        
  
  
  <xs:complexType name="auditEntity">
                
    
    
    <xs:complexContent>
                        
      
      
      <xs:extension base="baseEntity">
                                
        
        
        <xs:sequence/>
                              
      
      
      </xs:extension>
                      
    
    
    </xs:complexContent>
              
  
  
  </xs:complexType>
        
  
  
  <xs:complexType name="baseEntity">
                
    
    
    <xs:sequence>
                        
      
      
      <xs:element minOccurs="0" name="id" type="xs:long"/>
                      
    
    
    </xs:sequence>
              
  
  
  </xs:complexType>
        
  
  
  <xs:complexType name="baseEntityListener">
                
    
    
    <xs:sequence/>
              
  
  
  </xs:complexType>
        
  
  
  <xs:simpleType name="reinsuranceType">
                
    
    
    <xs:restriction base="xs:string">
                        
      
      
      <xs:enumeration value="STORNO"/>
                        
      
      
      <xs:enumeration value="SPORTS_ACTIVITY"/>
                      
    
    
    </xs:restriction>
              
  
  
  </xs:simpleType>
        
  
  
  <xs:simpleType name="insuranceType">
                
    
    
    <xs:restriction base="xs:string">
                        
      
      
      <xs:enumeration value="DAY"/>
                        
      
      
      <xs:enumeration value="YEAR"/>
                      
    
    
    </xs:restriction>
              
  
  
  </xs:simpleType>
        
  
  
  <xs:simpleType name="packet">
                
    
    
    <xs:restriction base="xs:string">
                        
      
      
      <xs:enumeration value="BASIC"/>
                        
      
      
      <xs:enumeration value="EXTEND"/>
                        
      
      
      <xs:enumeration value="EXTRA"/>
                      
    
    
    </xs:restriction>
              
  
  
  </xs:simpleType>
      


</xs:schema>
