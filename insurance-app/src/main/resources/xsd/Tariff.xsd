<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="/insurance/tariff" version="1.0">
      
  
  <xs:import schemaLocation="schema7.xsd"/>
      
  
  <xs:complexType name="tariff">
            
    
    <xs:sequence>
                  
      
      <xs:element minOccurs="0" name="id" type="xs:long"/>
                  
      
      <xs:element minOccurs="0" name="insuranceType" type="insuranceType"/>
                  
      
      <xs:element minOccurs="0" name="packet" type="packet"/>
                  
      
      <xs:element minOccurs="0" name="price" type="xs:decimal"/>
                  
      
      <xs:element name="active" type="xs:boolean"/>
                
    
    </xs:sequence>
          
  
  </xs:complexType>
    

</xs:schema>
